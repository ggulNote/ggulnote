{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@ggulnote/shared-types": ["packages/shared-types/src"],
      "@ggulnote/shared-types/*": ["packages/shared-types/src/*"],
      "@ggulnote/editor-core": ["packages/editor-core/src"],
      "@ggulnote/editor-core/*": ["packages/editor-core/src/*"]
    }
  }
}
