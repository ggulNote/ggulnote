{
  "name": "@ggulnote/editor-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@ggulnote/shared-types": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "vitest": "3.1.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "eslint": "^9",
    "rimraf": "^6.0.1"
  }
}